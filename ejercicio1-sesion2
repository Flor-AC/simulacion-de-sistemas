"""
Módulo: Simulación de Sistemas de Eventos discretos
Ejercicio 1: Simulación de líneas de Espera (Teoria de colas)
Descripción: Este script simula el comportamiento de una caja registradora o ventanilla de una cafeteria
vamos a estar calculando tiempos de espera, horas de salida y tiempo total que cada cliente pasa en el sistema.
"""

def simular_caja(llegadas: list, servicios: list) -> list[dict]:
    """
    Simula la atencion de clientes en un servidor unico
    Parámetros:
    -----------
    Llegadas: list 
        Lista con minutos en los que llega cada cliente.
    Servicios: list
        Lista con la duración (en minutos) del servicio de cada cliente.

    Retorna:
    --------
    list[dict]
        Tabla detallada con los tiempos de inicio, espera, salida y permanencia de cada cliente.
    """
    # Inicializamos listas vacìas para almacenar los resultados de cada cliente
    t_inicio = []  # Minuto exacto en que la caja empieza a atender al cliente
    t_espera = []  # Tiempo que el cliente pasa esperando en la fila (en minutos)
    t_salida = []  # Minuto exacto en que el cliente termina su atenciòn y se va 
    t_sistema = []  # Tiempo total que el cliente pasa en la tienda ( Espera + Servicio)

    # Variable para rastrear cuando quedarña desocupada la caja registradora
    t_caja_libre = 0

    # Recorremos cada cliente segùn su orden de llegada
    for i in range(len(llegadas)):
        arr = llegadas[i]  # Tempo de llegada del cliente i
        dur = servicios[i]  # Tiempo de servicio requerdio por el cliente i
        #El cliente entra a caja en su hora de llegada = cuando la caja se descoupe(lo que ocurra al últio)
        inicio = max(arr, t_caja_libre)

        #El tiempo de espera es la diferencia entre cuando entra a caja y cuando llegó
        espera = inicio - arr
        
        #El minuto de salida es cuando inicia la atencñon más la duración del servicio
        salida = inicio + dur

        #El tiempo total en el sistema es desde que llega hasta que se va
        sistema = salida - arr

        #Guardamos los resultados calculados en nuestras listas
        t_inicio.append(inicio)
        t_espera.append(espera)
        t_salida.append(salida)
        t_sistema.append(sistema)

        #Actualizamos la disponibilidad de la caja para el siguiente cliente
        t_caja_libre = salida

    # Construimos una tabla de diccionarios sin depender de pandas.
    return [
        {
            'Cliente': i + 1,
            'T_llegada': llegadas[i],
            'T_servicio': servicios[i],
            'T_inicio': t_inicio[i],
            'T_espera_Fila': t_espera[i],
            'T_salida': t_salida[i],
            'T_sistema': t_sistema[i],
        }
        for i in range(len(llegadas))
    ]

# --- Bloque principal de ejecución ---
if __name__ == "__main__":
    # Datos de entrada del problema (minutos de llegada y duración de atencón)
    tiempos_llegada = [0, 2, 4, 5, 7]
    tiempos_servicio = [3, 2, 1, 4, 2]

    # Ejecutamos la simulación 
    df_resultados = simular_caja(tiempos_llegada, tiempos_servicio)

    # Mostramos la tabla completa en consola
    print("=== Resultados de la simulacion de colas===")
    for cliente in df_resultados:
        print(cliente)

    # Calculamos e imprimimos los indicadores de desempeño principales (KPIs)
    promedio_espera = sum(c['T_espera_Fila'] for c in df_resultados) / len(df_resultados)
    promedio_sistema = sum(c['T_sistema'] for c in df_resultados) / len(df_resultados)

    print(f"\n=== Resumen de indicadores de desempeño ===")
    print(f"Tiempo promedio de espera en fila : {promedio_espera:.2f} minutos")
    print(f"Tiempo promedio en el sistema (espera + servicio): {promedio_sistema:.2f} minutos")